---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  title?: string;
}

const locale: Locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const { title = 'Arthur Azoula — Portfolio' } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Arthur Azoula — Backend Developer @ Adeo. Portfolio professionnel." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-cream text-brown antialiased overflow-x-hidden">
    <Header locale={locale} t={t} />
    <main>
      <slot />
    </main>
    <Footer t={t} />
    <script>
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('fade-in-up');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0% 0% -8% 0%' }
      );

      document.querySelectorAll('[data-animate]').forEach((el) => {
        revealObserver.observe(el);
      });

      const smoothObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
            }
          });
        },
        { threshold: 0.1 }
      );

      document.querySelectorAll('.smooth-reveal').forEach((el) => {
        smoothObserver.observe(el);
      });
    </script>
  </body>
</html>
