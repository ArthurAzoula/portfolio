---
import type { ContactTranslations } from '../i18n/types';

interface Props {
  t: { contact: ContactTranslations };
}
const { t } = Astro.props;
---

<section id="contact" class="snap-section relative">
  <div class="max-w-[75rem] mx-auto px-[1.5rem] w-full">
    <div class="max-w-[40rem] mx-auto text-center" data-animate>
      <p class="text-lime font-bold text-[0.75rem] uppercase tracking-widest mb-[0.75rem]">/ {t.contact.title}</p>
      <h2 class="text-[2.5rem] md:text-[3.75rem] font-black tracking-tight mb-[1.5rem]">
        {t.contact.title}<span class="text-lime">.</span>
      </h2>
      <p class="text-[1.125rem] md:text-[1.25rem] text-brown-light mb-[3rem]">
        {t.contact.subtitle}
      </p>

      <a
        href={`mailto:${t.contact.email}`}
        class="inline-flex items-center gap-[0.75rem] px-[2.5rem] py-[1.25rem] bg-brown text-cream font-bold text-[0.875rem] uppercase tracking-wider rounded-full hover:bg-lime hover:text-brown transition-all duration-300 group mb-[3rem]"
      >
        {t.contact.cta}
        <svg class="w-[1rem] h-[1rem] transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
