---
import type { Locale } from '../i18n';
import type { HeroTranslations } from '../i18n/types';

interface Props {
  t: { hero: HeroTranslations; nav: { expertise: string } };
  locale: Locale;
}
const { t } = Astro.props;
const cvFrPath = '/fr_cv_azoula_arthur.pdf';
const cvEnPath = '/en_cv_azoula_arthur.pdf';
---

<section id="hero" class="snap-section relative">
  <div class="max-w-[75rem] mx-auto px-[1.5rem] pt-[2rem] pb-[2rem] lg:pt-0 lg:pb-0 w-full relative z-[1]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[3rem] lg:gap-[5rem] items-center">
      <div class="lg:col-span-7">
        <div class="flex flex-wrap items-center gap-[0.625rem] mb-[2rem]" data-animate>
          <span class="inline-flex items-center gap-[0.625rem] px-[0.875rem] py-[0.5rem] rounded-full bg-white/50 border border-brown/10 backdrop-blur-xl">
            <span class="w-[0.5rem] h-[0.5rem] rounded-full bg-lime animate-pulse"></span>
            <span class="text-[0.75rem] font-bold uppercase tracking-[0.16em] text-brown-light">{t.hero.availability}</span>
          </span>
          <span class="inline-flex items-center px-[0.875rem] py-[0.5rem] rounded-full bg-sand/30 border border-brown/10 text-[0.75rem] font-bold uppercase tracking-[0.16em] text-brown-light">
            📍 {t.hero.location}
          </span>
        </div>

        <p class="text-brown-light text-[1rem] md:text-[1.125rem] mb-[1rem] font-medium" data-animate>
          {t.hero.greeting}
        </p>

        <h1 class="text-[3.75rem] sm:text-[4.5rem] md:text-[7rem] lg:text-[8.75rem] font-black leading-[0.86] tracking-[-0.08em] mb-[2rem]" data-animate>
          Arthur<br />
          Azoula<span class="text-lime">.</span>
        </h1>

        <p class="text-[1.25rem] md:text-[1.5rem] lg:text-[1.875rem] font-medium text-brown-light mb-[1.5rem]" data-animate>
          <span class="text-brown">{t.hero.role}</span>
          {' '}{t.hero.at}{' '}
          <span class="text-lime font-bold">Adeo</span>
        </p>

        <p class="text-[1rem] md:text-[1.125rem] text-brown-light max-w-[40rem] mb-[2.5rem] leading-relaxed" data-animate>
          {t.hero.subtitle}
        </p>

        <div class="flex flex-wrap items-center gap-[0.75rem]" data-animate>
          <a
            href="#projects"
            class="inline-flex items-center gap-[0.75rem] px-[2rem] py-[1rem] bg-brown text-cream font-bold text-[0.875rem] uppercase tracking-wider rounded-full hover:bg-lime hover:text-brown transition-all duration-500 group"
          >
            {t.hero.cta}
            <svg class="w-[1rem] h-[1rem] transition-transform group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <div class="relative" id="cv-dropdown-wrapper">
            <button
              id="cv-dropdown-btn"
              aria-haspopup="true"
              aria-expanded="false"
              class="inline-flex items-center gap-[0.5rem] px-[1.25rem] py-[1rem] rounded-full border border-brown/10 bg-white/30 backdrop-blur-xl text-[0.875rem] font-bold uppercase tracking-wider text-brown hover:border-lime/50 hover:text-lime-dark transition-all duration-500"
            >
              <svg class="w-[1rem] h-[1rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a1 1 0 001 1h16a1 1 0 001-1v-3" />
              </svg>
              {t.hero.downloadCV}
              <svg id="cv-chevron" class="w-[0.75rem] h-[0.75rem] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              id="cv-dropdown-menu"
              class="absolute left-0 mt-[0.375rem] min-w-[10rem] bg-cream border border-brown/10 rounded-2xl shadow-lg py-[0.375rem] z-50 hidden"
              role="menu"
            >
              <a
                href={cvFrPath}
                download
                class="flex items-center gap-[0.5rem] px-[1rem] py-[0.625rem] text-[0.8rem] font-bold text-brown hover:text-lime-dark hover:bg-sand/30 rounded-xl mx-[0.25rem] transition-colors"
                role="menuitem"
              >
                🇫🇷 {t.hero.downloadCVFr}
              </a>
              <a
                href={cvEnPath}
                download
                class="flex items-center gap-[0.5rem] px-[1rem] py-[0.625rem] text-[0.8rem] font-bold text-brown hover:text-lime-dark hover:bg-sand/30 rounded-xl mx-[0.25rem] transition-colors"
                role="menuitem"
              >
                🇬🇧 {t.hero.downloadCVEn}
              </a>
            </div>
          </div>

          <a href="#expertise" class="inline-flex items-center px-[1.5rem] py-[1rem] rounded-full border border-brown/10 bg-white/30 backdrop-blur-xl text-[0.875rem] font-bold uppercase tracking-wider text-brown hover:border-lime/50 transition-all duration-500">
            {t.nav.expertise}
          </a>
        </div>
      </div>

      <aside class="lg:col-span-5" data-animate>
          <div class="hero-panel">
            <div class="hero-panel__photo">
            <img
              src="/avatar.jpg"
              srcset="/avatar-600.jpg 600w, /avatar.jpg 1200w, /avatar-2400.jpg 2400w"
              sizes="18rem"
              alt="Arthur Azoula"
              class="w-full h-full object-cover"
              decoding="async"
            />
          </div>
          <div class="relative z-[2]">
            <p class="text-[0.75rem] uppercase tracking-[0.18em] text-cream/70 mb-[1.5rem]">Selected proof</p>
            <div class="grid grid-cols-2 gap-[0.75rem]">
              {t.hero.proof.map((item: string) => (
                <span class="proof-tile">{item}</span>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div class="absolute right-0 top-1/4 w-[20rem] h-[20rem] md:w-[32rem] md:h-[32rem] rounded-full bg-lime/[0.06] -z-10"></div>
  <div class="absolute right-[8rem] bottom-1/4 w-[10rem] h-[10rem] md:w-[18rem] md:h-[18rem] rounded-full bg-sand/20 -z-10"></div>
</section>

<script>
  const btn = document.getElementById('cv-dropdown-btn');
  const menu = document.getElementById('cv-dropdown-menu');
  const chevron = document.getElementById('cv-chevron');

  function openDropdown(): void {
    menu?.classList.remove('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    if (chevron) chevron.style.transform = 'rotate(180deg)';
  }

  function closeDropdown(): void {
    menu?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    if (chevron) chevron.style.transform = '';
  }

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.contains('hidden') ? openDropdown() : closeDropdown();
  });

  document.addEventListener('click', closeDropdown);

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeDropdown);
  });
</script>
