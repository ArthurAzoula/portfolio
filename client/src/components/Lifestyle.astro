---
import type { LifestyleTranslations, LifestyleItem } from '../i18n/types';
import StravaStats from './StravaStats';

interface Props {
  t: { lifestyle: LifestyleTranslations };
  locale?: string;
}
const { t, locale = 'fr' } = Astro.props;

const lifestylePhotos: Record<string, string> = {
  'Voyages': '/lifestyle/travel.jpg',
  'Travel': '/lifestyle/travel.jpg',
  'Mon chien': '/lifestyle/dog.jpg',
  'My dog': '/lifestyle/dog.jpg',
  'Mon setup': '/lifestyle/setup.jpg',
  'My setup': '/lifestyle/setup.jpg',
};
---

<section id="lifestyle" class="snap-section-auto py-[6rem] md:py-[8rem]">
  <div class="max-w-[75rem] mx-auto px-[1.5rem]">
    <!-- Section header -->
    <div class="mb-[4rem] md:mb-[5rem] text-center" data-animate>
      <p class="text-lime font-bold text-[0.75rem] uppercase tracking-widest mb-[0.75rem]">/ {t.lifestyle.title}</p>
      <h2 class="text-[2.5rem] md:text-[3.75rem] font-black tracking-tight">
        {t.lifestyle.title}<span class="text-lime">.</span>
      </h2>
      <p class="text-brown-light text-[1.125rem] mt-[1rem] max-w-[28rem] mx-auto">
        {t.lifestyle.subtitle}
      </p>
    </div>

    <!-- Sport section -->
    <div class="max-w-[60rem] mx-auto mb-[3rem]" data-animate>
      <p class="text-[0.6875rem] font-black uppercase tracking-[0.14em] text-brown-light mb-[1rem]">
        {t.lifestyle.sportLabel}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[1.5rem]">
        <!-- Tennis card -->
        <div class="lifestyle-card lifestyle-card--tennis min-h-[20rem] smooth-reveal stagger-1">
          <img
            src="/lifestyle/tennis.jpg"
            alt={t.lifestyle.tennis.title}
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-lime/10"></div>
          <div class="tennis-profile">
            <a href={t.lifestyle.tennis.tenup} target="_blank" rel="noopener noreferrer">
              Ten'Up · FFT
            </a>
          </div>
          <div class="lifestyle-card-content">
            <span class="text-[1.5rem] mb-[0.25rem] block">🎾</span>
            <h3 class="text-[1.25rem] font-bold">{t.lifestyle.tennis.title}</h3>
            <p class="text-[0.8125rem] opacity-80">{t.lifestyle.tennis.subtitle}</p>
          </div>
        </div>

        <!-- Strava widget -->
        <div class="smooth-reveal stagger-2">
          <StravaStats locale={locale} client:load />
        </div>
      </div>
    </div>

    <!-- Other lifestyle items -->
    <div class="max-w-[60rem] mx-auto" data-animate>
      <p class="text-[0.6875rem] font-black uppercase tracking-[0.14em] text-brown-light mb-[1rem]">
        {t.lifestyle.otherLabel}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-[1rem]">
        {t.lifestyle.items.map((item: LifestyleItem, index: number) => (
          <div class={`lifestyle-card lifestyle-card--small smooth-reveal stagger-${index + 3}`}>
            <img
              src={lifestylePhotos[item.title] || ''}
              alt={item.title}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div class="absolute inset-0 bg-brown/20"></div>
            <div class="lifestyle-card-content">
              <span class="text-[1.25rem] mb-[0.25rem] block">{item.emoji}</span>
              <h3 class="text-[1rem] font-bold">{item.title}</h3>
              <p class="text-[0.75rem] opacity-80">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
