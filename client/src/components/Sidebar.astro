---
import type { Locale } from '../i18n';
import type { Translations } from '../i18n/types';
import { getLocalizedPath } from '../i18n';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr';
const currentPath = Astro.url.pathname;

const navItems = [
  { id: 'hero', label: 'Home' },
  { id: 'expertise', label: t.nav.expertise },
  { id: 'projects', label: t.nav.projects },
  { id: 'about', label: t.nav.experience },
  { id: 'lifestyle', label: 'Lifestyle' },
];
---

<!-- Desktop Sidebar -->
<nav id="sidebar" class="fixed left-0 top-0 h-full w-[4.5rem] z-50 flex-col items-center py-[2rem] justify-between bg-cream/80 backdrop-blur-xl border-r border-brown/[0.06] hidden md:flex" aria-label="Navigation principale">
  <!-- Logo -->
  <a href={locale === 'fr' ? '/' : '/en/'} class="text-[1.125rem] font-black tracking-tight text-brown hover:text-lime-dark transition-colors">
    A<span class="text-lime">.</span>
  </a>

  <!-- Nav Links -->
  <div class="flex flex-col items-center gap-[0.25rem]">
    <a href="#" class="sidebar-link group relative flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-xl text-brown-light hover:text-brown hover:bg-brown/[0.05] transition-all duration-200" data-section="hero" aria-label="Home">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
      <span class="sidebar-tooltip">Home</span>
    </a>
    <a href="#expertise" class="sidebar-link group relative flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-xl text-brown-light hover:text-brown hover:bg-brown/[0.05] transition-all duration-200" data-section="expertise" aria-label={t.nav.expertise}>
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
      <span class="sidebar-tooltip">{t.nav.expertise}</span>
    </a>
    <a href="#projects" class="sidebar-link group relative flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-xl text-brown-light hover:text-brown hover:bg-brown/[0.05] transition-all duration-200" data-section="projects" aria-label={t.nav.projects}>
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
      <span class="sidebar-tooltip">{t.nav.projects}</span>
    </a>
    <a href="#about" class="sidebar-link group relative flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-xl text-brown-light hover:text-brown hover:bg-brown/[0.05] transition-all duration-200" data-section="about" aria-label={t.nav.experience}>
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
      <span class="sidebar-tooltip">{t.nav.experience}</span>
    </a>
    <a href="#lifestyle" class="sidebar-link group relative flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-xl text-brown-light hover:text-brown hover:bg-brown/[0.05] transition-all duration-200" data-section="lifestyle" aria-label="Lifestyle">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      <span class="sidebar-tooltip">Lifestyle</span>
    </a>
  </div>

  <!-- Bottom: socials + lang -->
  <div class="flex flex-col items-center gap-[0.5rem]">
    <a href="https://github.com/ArthurAzoula" target="_blank" rel="noopener noreferrer" class="sidebar-social" aria-label="GitHub">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
    </a>
    <a href="https://www.linkedin.com/in/arthur-azoula" target="_blank" rel="noopener noreferrer" class="sidebar-social" aria-label="LinkedIn">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
    </a>
    <a href="mailto:arthur2504azoula@gmail.com" class="sidebar-social" aria-label="Email">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    </a>

    <div class="w-[1.5rem] h-px bg-brown/10 my-[0.25rem]"></div>

    <a
      href={getLocalizedPath(currentPath, otherLocale)}
      class="w-[2.25rem] h-[2.25rem] flex items-center justify-center rounded-lg text-[0.625rem] font-black uppercase tracking-wider text-brown-light border border-brown/10 hover:border-lime hover:text-lime transition-all duration-200"
    >
      {otherLocale.toUpperCase()}
    </a>
  </div>
</nav>

<!-- Mobile Bottom Bar -->
<nav id="mobile-bar" class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-cream/90 backdrop-blur-xl border-t border-brown/[0.08] safe-area-bottom" aria-label="Navigation mobile">
  <div class="flex items-center justify-around px-[0.5rem] py-[0.375rem]">
    <a href="#expertise" class="mobile-nav-link flex flex-col items-center gap-[0.125rem] py-[0.25rem] px-[0.5rem] rounded-lg text-brown-light transition-colors duration-200" data-section="expertise">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
      <span class="text-[0.5625rem] font-bold">{t.nav.expertise}</span>
    </a>
    <a href="#projects" class="mobile-nav-link flex flex-col items-center gap-[0.125rem] py-[0.25rem] px-[0.5rem] rounded-lg text-brown-light transition-colors duration-200" data-section="projects">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
      <span class="text-[0.5625rem] font-bold">{t.nav.projects}</span>
    </a>
    <a href="#about" class="mobile-nav-link flex flex-col items-center gap-[0.125rem] py-[0.25rem] px-[0.5rem] rounded-lg text-brown-light transition-colors duration-200" data-section="about">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
      <span class="text-[0.5625rem] font-bold">{t.nav.experience}</span>
    </a>
    <a href="#lifestyle" class="mobile-nav-link flex flex-col items-center gap-[0.125rem] py-[0.25rem] px-[0.5rem] rounded-lg text-brown-light transition-colors duration-200" data-section="lifestyle">
      <svg class="w-[1.125rem] h-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      <span class="text-[0.5625rem] font-bold">Life</span>
    </a>
  </div>
</nav>

<script>
  const sections = document.querySelectorAll('section[id], section:first-of-type');
  const sidebarLinks = document.querySelectorAll('.sidebar-link');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function setActive(id: string) {
    [...sidebarLinks, ...mobileLinks].forEach((link) => {
      const section = (link as HTMLElement).dataset.section;
      if (section === id) {
        link.classList.add('sidebar-active');
      } else {
        link.classList.remove('sidebar-active');
      }
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id || 'hero';
          setActive(id);
        }
      });
    },
    { threshold: 0.15, rootMargin: '-5% 0% -50% 0%' }
  );

  sections.forEach((s) => observer.observe(s));
</script>
